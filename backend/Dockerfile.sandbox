FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash sandbox
WORKDIR /workspace
RUN chown -R sandbox:sandbox /workspace
USER sandbox

CMD ["tail", "-f", "/dev/null"]
