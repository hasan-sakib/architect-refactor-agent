FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Explicit uid/gid (not just useradd's default) so the backend's post-upload
# chown (routes.py's _chown_tree, matching settings.SANDBOX_UID/GID) always
# targets the right numeric owner regardless of how this image's defaults
# might shift over time.
RUN groupadd -g 1000 sandbox && useradd -m -u 1000 -g 1000 -s /bin/bash sandbox

ENV HOME=/home/sandbox \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /workspace
RUN chown -R sandbox:sandbox /workspace
USER 1000:1000

# Keep-alive: DockerSandboxDriver drives all real work via exec_run and
# overrides this at container-start time anyway (see docker_driver.py).
CMD ["sleep", "infinity"]
