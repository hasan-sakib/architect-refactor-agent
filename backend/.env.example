# LLM Configuration (LiteLLM abstraction — swap models by editing this file only)
LLM_MODEL_NAME=ollama_chat/qwen2.5-coder
OLLAMA_API_BASE=http://localhost:11434
LITELLM_API_KEY=

# Sandbox Configuration (BaseSandboxDriver / DockerSandboxDriver)
SANDBOX_IMAGE_NAME=refactor-agent-sandbox
SANDBOX_IMAGE_TAG=latest
SANDBOX_DOCKERFILE_PATH=Dockerfile.sandbox
DOCKER_SOCKET_URL=
SANDBOX_WORKSPACE_MOUNT=/workspace
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0
SANDBOX_NETWORK_DISABLED=false

# RAG / Vector DB (Phase 2: Tree-sitter chunker + ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=codebase
RAG_CHUNK_MAX_BYTES=4000

# App
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Limits (production hardening)
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_FILE_BYTES=10485760
MAX_UPLOAD_FILES=1000
TEST_COMMAND_TIMEOUT=240
TASK_MAX_WALL_SECONDS=900
MAX_CONCURRENT_TASKS=3

# Auth & persistence
# AUTH_MODE=disabled is the local-dev escape hatch — every request is a fixed
# synthetic user, no Supabase project needed. Set AUTH_MODE=supabase and fill
# in the SUPABASE_* values below once you've created a project.
AUTH_MODE=disabled
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/refactor_agent
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
STREAM_TICKET_SECRET=local-dev-insecure-stream-ticket-secret
STREAM_TICKET_TTL_SECONDS=600
# Local/admin only — lets the "type a host path" field work, and only if the
# backend container actually has that path mounted (it doesn't by default —
# see docker-compose.yml's scoped uploads-only mount). The product is
# uploads-only; leave this false unless you've deliberately widened the mount.
ALLOW_ARBITRARY_REPO_PATH=false
